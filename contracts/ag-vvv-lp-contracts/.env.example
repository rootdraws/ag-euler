# AG Test Market (agVVVWETHlp / USDC) — Base mainnet — Deployment Environment

# ─── RPC ───
RPC_URL_BASE=

# ─── Deployer ───
# This key is both the initial governor of the Euler vaults AND the broadcaster.
# Use the canary EOA (0x701a27330d13728a60bBe37DECde9D5a6c7402E5) if you want
# governor to match the agVVVWETHlp vault's HARVESTER_ROLE, otherwise any wallet
# works — just transfer governance later with cast send setGovernorAdmin / transferGovernance.
PRIVATE_KEY=
BASESCAN_API_KEY=

# ─── Outputs (filled by scripts as you deploy) ───
# Step 1
KINK_IRM=
# Step 2
EULER_ROUTER=
# Step 3
USDC_BORROW_VAULT=
# Step 4
COLLATERAL_VAULT=

# ─── Optional ───
# Set to skip step 07 (FEE_RECEIVER is hardcoded in Addresses.sol = AG curator)
FEE_RECEIVER=0x4f894Bfc9481110278C356adE1473eBe2127Fd3C
