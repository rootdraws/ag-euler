# Copy to `.env` and fill in — loaded by foundry via `source .env` before `forge script`.
# Never commit `.env`. The deploy scripts read these with `vm.envAddress` / forge's own
# `--rpc-url` / `--private-key` / `--etherscan-api-key` flags.

# ─────────────────────────────────────────────────────────────────────────────
# Broadcast credentials (consumed by forge directly, not the scripts)
# ─────────────────────────────────────────────────────────────────────────────

# Deployer key. Prefer `--private-key $PRIVATE_KEY` on the CLI over leaving it here.
# For hardware wallets use `--ledger` / `--trezor` and leave this unset.
PRIVATE_KEY=

# RPC endpoint for the target chain.
RPC_URL=

# Block explorer API key for `--verify`. Optional — omit if not verifying.
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DeploySettlers.s.sol
# ─────────────────────────────────────────────────────────────────────────────

# Optional: skip `networks.json` resolution and force the CorkCellarFactory address.
# Useful for fresh chains or local forks where networks.json has no entry yet.
FACTORY_ADDRESS_OVERRIDE=

# ─────────────────────────────────────────────────────────────────────────────
# DeployFillers.s.sol
# ─────────────────────────────────────────────────────────────────────────────

# Optional overrides for the settler addresses the reference fillers bind to.
# When unset the script falls back to `networks.json` entries at
# `.ExactFillSettler.<chainId>.address` / `.PartialFillSettler.<chainId>.address`.
# `address(0)` is rejected — leave blank to use the networks.json path.
EXACT_SETTLER_OVERRIDE=
PARTIAL_SETTLER_OVERRIDE=
